{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "staging-gymkhana-api",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile.api",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiContainer"]
    }
  ],
  "vars": {
    "AUTH_APPLICATION_URL": "https://staging-gymkhana-database.0489dcd6-95ac-4740-817c-94c0211c6141.workers.dev",
    "AUTH_ALLOWED_EMAILS": "tocadogamba.database@gmail.com",
    "AUTH_SUPERADMIN_EMAIL": "tocadogamba.database@gmail.com",
    "GOOGLE_OAUTH_REDIRECT_URL": "https://staging-gymkhana-api.0489dcd6-95ac-4740-817c-94c0211c6141.workers.dev/auth/callback",
    "R2_ENABLED": "false",
    "R2_BUCKET": "gymkhana-files"
  }
}
