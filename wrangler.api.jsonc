{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "staging-gymkhana-api",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile.api",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiContainer"],
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "31001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "vars": {
    "AUTH_APPLICATION_URL": "https://staging-gymkhana-database.0489dcd6-95ac-4740-817c-94c0211c6141.workers.dev",
    "GOOGLE_OAUTH_REDIRECT_URL": "https://staging-gymkhana-api.0489dcd6-95ac-4740-817c-94c0211c6141.workers.dev/auth/callback",
    "R2_ENABLED": "true",
    "R2_BUCKET": "gymkhana-files",
    "OCR_ENABLED": "true",
    "OCR_PROVIDER": "google",
    "OCR_MODEL": "gemini-2.5-flash",
    "OCR_TIMEOUT": "90s",
    "OCR_MAX_REQUESTS_PER_HOUR": "10",
    "OCR_MAX_PROVIDER_USAGE_PER_HOUR": "500000",
    "OCR_MAX_SOURCE_BYTES": "20971520",
  },
}
