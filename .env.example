# Catalog of environment names for the lokeys `gymkhana` profile.
# Do not copy this file to `.env`. Inject values with:
#   lokeys run -p gymkhana --env dev -- <command>
# lokeys --env dev sets APP_ENV=development, which the application treats as local.
# Production and staging builds require immutable release metadata injected by the Docker build.
# Local binaries keep the development identity and do not require release environment variables.
APP_ENV=local
HTTP_ADDRESS=:8080
HTTP_MAX_BODY_BYTES=1048576
# Local Compose value belongs in lokeys, not a copied .env:
# postgres://gymkhana:gymkhana@localhost:5432/gymkhana?sslmode=disable
DATABASE_URL=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Leave empty for a continuous local worker. Cloud Run Jobs require a bounded duration
# shorter than the platform task timeout so River clients can drain on SIGTERM.
WORKER_RUN_DURATION=

# Authentication is disabled by default in local and test environments.
# Set AUTH_ENABLED=true to exercise the login screen locally. The Dev Login button skips
# the Google exchange, but the auth service still expects non-empty local OAuth placeholders.
AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=development-local
# Keep the real client secret in the lokeys gymkhana profile.
GOOGLE_OAUTH_CLIENT_SECRET=development-local
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
AUTH_APPLICATION_URL=http://localhost:5173
# The development login uses AUTH_SUPERADMIN_EMAIL and requires it to be present here.
AUTH_ALLOWED_EMAILS=developer@gymkhana.local
AUTH_SUPERADMIN_EMAIL=developer@gymkhana.local

# Owner-scoped Google Forms ingestion is disabled until OAuth and encryption are configured.
GOOGLE_FORMS_ENABLED=false
GOOGLE_FORMS_OAUTH_CLIENT_ID=
# Keep the client secret and token keys in lokeys locally, or in a deployment secret manager.
GOOGLE_FORMS_OAUTH_CLIENT_SECRET=
GOOGLE_FORMS_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/google-forms/oauth/callback
# Base64-encoded 32-byte AES-256 key and its positive version.
GOOGLE_FORMS_TOKEN_ENCRYPTION_KEY=
GOOGLE_FORMS_TOKEN_KEY_VERSION=1
# Optional comma-separated previous version:base64 keys retained during rotation.
GOOGLE_FORMS_TOKEN_DECRYPTION_KEYS=
GOOGLE_FORMS_SYNC_INTERVAL=15m
GOOGLE_FORMS_RESPONSE_PAGE_SIZE=100

# Private read-only AI Chat stays disabled until the owner selects a production provider/model and retention policy.
AI_CHAT_ENABLED=false
AI_CHAT_PROVIDER=
AI_CHAT_MODEL=
# Required only when enabled; deliberately has no production default (example syntax: 168h).
AI_CHAT_RETENTION=

# Private multimodal/OCR extraction stays disabled until the owner selects a production provider/model.
# The deterministic fake adapter is accepted only with APP_ENV=test.
OCR_ENABLED=false
OCR_PROVIDER=
OCR_MODEL=
OCR_TIMEOUT=90s
OCR_MAX_REQUESTS_PER_HOUR=10
OCR_MAX_PROVIDER_USAGE_PER_HOUR=500000
OCR_MAX_SOURCE_BYTES=20971520

# Private Cloudflare R2 attachments are disabled until all values are configured.
R2_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
# Keep real R2 credentials in lokeys locally, or in a deployment secret manager.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_UPLOAD_TTL=10m
ATTACHMENT_DOWNLOAD_TTL=5m
ATTACHMENT_TRASH_RETENTION=168h
ATTACHMENT_MAX_FILE_BYTES=52428800
# Global stored + active-upload reservation cap (5 GiB by default).
ATTACHMENT_MAX_TOTAL_BYTES=5368709120
# Maximum upload intents per authenticated user in a rolling minute.
ATTACHMENT_UPLOAD_RATE_LIMIT=12
ATTACHMENT_CLEANUP_BATCH=100

# Configure this in the Vercel project environment for preview/production builds.
VITE_API_BASE_URL=http://localhost:8080
