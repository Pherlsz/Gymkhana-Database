APP_ENV=local
HTTP_ADDRESS=:8080
HTTP_MAX_BODY_BYTES=1048576
DATABASE_URL=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Authentication is disabled by default in local and test environments.
AUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
# Keep the real value only in the local or deployment secret manager.
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
AUTH_APPLICATION_URL=http://localhost:5173
AUTH_ALLOWED_GITHUB_LOGINS=
AUTH_SUPERADMIN_GITHUB_LOGIN=

# Owner-scoped Google Forms ingestion is disabled until OAuth and encryption are configured.
GOOGLE_FORMS_ENABLED=false
GOOGLE_FORMS_OAUTH_CLIENT_ID=
# Keep the client secret and token keys only in a secret manager.
GOOGLE_FORMS_OAUTH_CLIENT_SECRET=
GOOGLE_FORMS_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/google-forms/oauth/callback
# Base64-encoded 32-byte AES-256 key and its positive version.
GOOGLE_FORMS_TOKEN_ENCRYPTION_KEY=
GOOGLE_FORMS_TOKEN_KEY_VERSION=1
# Optional comma-separated previous version:base64 keys retained during rotation.
GOOGLE_FORMS_TOKEN_DECRYPTION_KEYS=
GOOGLE_FORMS_SYNC_INTERVAL=15m
GOOGLE_FORMS_RESPONSE_PAGE_SIZE=100

# Private Cloudflare R2 attachments are disabled until all values are configured.
R2_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
# Keep real R2 credentials only in the local or deployment secret manager.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_UPLOAD_TTL=10m
ATTACHMENT_DOWNLOAD_TTL=5m
ATTACHMENT_TRASH_RETENTION=168h
ATTACHMENT_MAX_FILE_BYTES=52428800
# Global stored + active-upload reservation cap (5 GiB by default).
ATTACHMENT_MAX_TOTAL_BYTES=5368709120
# Maximum upload intents per authenticated user in a rolling minute.
ATTACHMENT_UPLOAD_RATE_LIMIT=12
ATTACHMENT_CLEANUP_BATCH=100

VITE_API_BASE_URL=http://localhost:8080
