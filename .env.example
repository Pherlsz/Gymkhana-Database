# Copy to `.env` and fill in real values. Never commit `.env`.
# Local, Cursor Cloud, and CI all read this file (process env already set wins).
# APP_ENV=development is treated as local.
# Production and staging builds require immutable release metadata injected at release build time.
# Local binaries keep the development identity and do not require release environment variables.
APP_ENV=local
HTTP_ADDRESS=:8080
HTTP_MAX_BODY_BYTES=1048576
# Neon only (README). Direct compute, not a PgBouncer -pooler URL.
# postgresql://<owner>:<pw>@<ep-...>.neon.tech/gymkhana?sslmode=require
DATABASE_URL=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Leave empty for a continuous local worker. Cloud Run Jobs require a bounded duration
# shorter than the platform task timeout so River clients can drain on SIGTERM.
WORKER_RUN_DURATION=

# Authentication is disabled by default in local and test environments.
# Set AUTH_ENABLED=true to exercise the login screen locally. The Dev Login button skips
# the Google exchange, but the auth service still expects non-empty local OAuth placeholders.
AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=development-local
GOOGLE_OAUTH_CLIENT_SECRET=development-local
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
AUTH_APPLICATION_URL=http://localhost:5173
# Access is the Neon allowed_emails table + provisioned app_users (Administração).
# Local Dev Login uses a fixed identity developer@gymkhana.local (not configurable).

# Google Forms OAuth credentials. Product on/off is Administração → Funcionalidades.
GOOGLE_FORMS_OAUTH_CLIENT_ID=
GOOGLE_FORMS_OAUTH_CLIENT_SECRET=
GOOGLE_FORMS_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/google-forms/oauth/callback
# Base64-encoded 32-byte AES-256 key and its positive version.
GOOGLE_FORMS_TOKEN_ENCRYPTION_KEY=
GOOGLE_FORMS_TOKEN_KEY_VERSION=1
# Optional comma-separated previous version:base64 keys retained during rotation.
GOOGLE_FORMS_TOKEN_DECRYPTION_KEYS=
GOOGLE_FORMS_SYNC_INTERVAL=15m
GOOGLE_FORMS_RESPONSE_PAGE_SIZE=100

# Assistente adapter. Product on/off is Administração → Funcionalidades.
# Set AI_CHAT_PROVIDER=google (with model, retention, and encryption key) to compose the service.
# Provider `google` reads the shared key stored in Administração; the API key never goes here.
AI_CHAT_PROVIDER=
AI_CHAT_MODEL=gemini-2.5-flash
AI_CHAT_RETENTION=336h

# OCR adapter. Product on/off is Administração → Funcionalidades.
# Set OCR_PROVIDER=google (with model and encryption key) to compose the service. `fake` is test-only.
OCR_PROVIDER=
OCR_MODEL=gemini-2.5-flash
OCR_TIMEOUT=90s
OCR_MAX_REQUESTS_PER_HOUR=10
OCR_MAX_PROVIDER_USAGE_PER_HOUR=500000
OCR_MAX_SOURCE_BYTES=20971520

# Cloudflare R2 credentials. Product on/off is Administração → Funcionalidades (Anexos).
# Storage composes when endpoint, bucket, and keys are all set.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_UPLOAD_TTL=10m
ATTACHMENT_DOWNLOAD_TTL=5m
ATTACHMENT_TRASH_RETENTION=168h
ATTACHMENT_MAX_FILE_BYTES=52428800
# Global stored + active-upload reservation cap (5 GiB by default).
ATTACHMENT_MAX_TOTAL_BYTES=5368709120
# Maximum upload intents per authenticated user in a rolling minute.
ATTACHMENT_UPLOAD_RATE_LIMIT=12
ATTACHMENT_CLEANUP_BATCH=100

# Staging/production SPA builds must reach the API Worker.
# Local: http://localhost:8080 (or leave unset and use Vite proxy for /api + /health).
# Staging workers.dev: set the API origin, or rely on apiURL hostname inference
# (staging-gymkhana-database.* → staging-gymkhana-api.*). Workers Builds has no .env;
# `pnpm build:web` asserts the bundle keeps that inference (or a baked https API URL).
VITE_API_BASE_URL=http://localhost:8080
