[database]
# Point at the Neon compute for your environment (README "Neon only").
# Never store credentials here: make migrate passes --conn-string from
# $DATABASE_URL, which lokeys injects. This file only documents the shape.
host = <neon-ep-name>.sa-east-1.aws.neon.tech
port = 5432
database = gymkhana
sslmode = require
