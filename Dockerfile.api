# Runtime image for Cloudflare Containers.
# Build the linux/amd64 binary on the host first:
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o .tmp/api ./cmd/api
FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY .tmp/api /api
COPY workers/api/entrypoint.sh /entrypoint.sh
RUN chmod +x /api /entrypoint.sh
ENV HTTP_ADDRESS=:8080
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
