# Runtime image for Cloudflare Containers (API + River worker).
# Build linux/amd64 binaries on the host first:
#   pnpm build:api:linux
FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY .tmp/api /api
COPY .tmp/worker /worker
COPY workers/api/entrypoint.sh /entrypoint.sh
RUN chmod +x /api /worker /entrypoint.sh
ENV HTTP_ADDRESS=:8080
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
