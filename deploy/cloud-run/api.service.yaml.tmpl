apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: __API_SERVICE_NAME__
  labels:
    cloud.googleapis.com/location: __REGION__
    app.kubernetes.io/name: gymkhana-database-api
    app.kubernetes.io/version: __RELEASE_VERSION__
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gymkhana-database-api
        app.kubernetes.io/version: __RELEASE_VERSION__
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "__API_MAX_INSTANCES__"
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/startup-cpu-boost: "true"
    spec:
      serviceAccountName: __RUNTIME_SERVICE_ACCOUNT__
      containerConcurrency: 80
      timeoutSeconds: 60
      containers:
        - name: api
          image: __API_IMAGE_DIGEST__
          ports:
            - name: http1
              containerPort: 8080
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          env:
            - name: APP_ENV
              value: production
            - name: HTTP_ADDRESS
              value: :8080
            - name: LOG_LEVEL
              value: info
            - name: SHUTDOWN_TIMEOUT
              value: 10s
            - name: AUTH_ENABLED
              value: "true"
            - name: AUTH_APPLICATION_URL
              value: __APPLICATION_URL__
            - name: AUTH_ALLOWED_GITHUB_LOGINS
              value: __ALLOWED_GITHUB_LOGINS__
            - name: AUTH_SUPERADMIN_GITHUB_LOGIN
              value: __SUPERADMIN_GITHUB_LOGIN__
            - name: GITHUB_OAUTH_REDIRECT_URL
              value: __API_BASE_URL__/auth/callback
            - name: R2_ENABLED
              value: "true"
            - name: R2_ENDPOINT
              value: __R2_ENDPOINT__
            - name: R2_BUCKET
              value: __R2_BUCKET__
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: __DATABASE_URL_SECRET__
                  key: __DATABASE_URL_SECRET_VERSION__
            - name: GITHUB_OAUTH_CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: __GITHUB_OAUTH_CLIENT_ID_SECRET__
                  key: __GITHUB_OAUTH_CLIENT_ID_SECRET_VERSION__
            - name: GITHUB_OAUTH_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: __GITHUB_OAUTH_CLIENT_SECRET_SECRET__
                  key: __GITHUB_OAUTH_CLIENT_SECRET_SECRET_VERSION__
            - name: R2_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: __R2_ACCESS_KEY_ID_SECRET__
                  key: __R2_ACCESS_KEY_ID_SECRET_VERSION__
            - name: R2_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: __R2_SECRET_ACCESS_KEY_SECRET__
                  key: __R2_SECRET_ACCESS_KEY_SECRET_VERSION__
          startupProbe:
            httpGet:
              path: /health/ready
              port: 8080
            initialDelaySeconds: 0
            timeoutSeconds: 2
            periodSeconds: 2
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /health/live
              port: 8080
            initialDelaySeconds: 10
            timeoutSeconds: 2
            periodSeconds: 10
            failureThreshold: 3
  traffic:
    - percent: 100
      latestRevision: true
