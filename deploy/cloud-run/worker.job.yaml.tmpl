apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: __WORKER_JOB_NAME__
  labels:
    cloud.googleapis.com/location: __REGION__
    app.kubernetes.io/name: gymkhana-database-worker
    app.kubernetes.io/version: __RELEASE_VERSION__
spec:
  template:
    metadata:
      annotations:
        run.googleapis.com/execution-environment: gen2
    spec:
      taskCount: 1
      template:
        spec:
          serviceAccountName: __RUNTIME_SERVICE_ACCOUNT__
          maxRetries: 1
          timeoutSeconds: "900"
          containers:
            - name: worker
              image: __WORKER_IMAGE_DIGEST__
              resources:
                limits:
                  cpu: "1"
                  memory: 1Gi
              env:
                - name: APP_ENV
                  value: production
                - name: LOG_LEVEL
                  value: info
                - name: SHUTDOWN_TIMEOUT
                  value: 45s
                - name: WORKER_RUN_DURATION
                  value: 14m
                - name: AUTH_ENABLED
                  value: "true"
                - name: AUTH_APPLICATION_URL
                  value: __APPLICATION_URL__
                - name: AUTH_ALLOWED_EMAILS
                  value: __ALLOWED_EMAILS__
                - name: AUTH_SUPERADMIN_EMAIL
                  value: __SUPERADMIN_EMAIL__
                - name: GOOGLE_OAUTH_REDIRECT_URL
                  value: __API_BASE_URL__/auth/callback
                - name: R2_ENABLED
                  value: "true"
                - name: R2_ENDPOINT
                  value: __R2_ENDPOINT__
                - name: R2_BUCKET
                  value: __R2_BUCKET__
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      name: __DATABASE_URL_SECRET__
                      key: __DATABASE_URL_SECRET_VERSION__
                - name: GOOGLE_OAUTH_CLIENT_ID
                  valueFrom:
                    secretKeyRef:
                      name: __GOOGLE_OAUTH_CLIENT_ID_SECRET__
                      key: __GOOGLE_OAUTH_CLIENT_ID_SECRET_VERSION__
                - name: GOOGLE_OAUTH_CLIENT_SECRET
                  valueFrom:
                    secretKeyRef:
                      name: __GOOGLE_OAUTH_CLIENT_SECRET_SECRET__
                      key: __GOOGLE_OAUTH_CLIENT_SECRET_SECRET_VERSION__
                - name: R2_ACCESS_KEY_ID
                  valueFrom:
                    secretKeyRef:
                      name: __R2_ACCESS_KEY_ID_SECRET__
                      key: __R2_ACCESS_KEY_ID_SECRET_VERSION__
                - name: R2_SECRET_ACCESS_KEY
                  valueFrom:
                    secretKeyRef:
                      name: __R2_SECRET_ACCESS_KEY_SECRET__
                      key: __R2_SECRET_ACCESS_KEY_SECRET_VERSION__
